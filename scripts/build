#!/usr/bin/env bash
# Builds the release files into dist/ (R5), for the owner's machines: on Linux
# one AppImage (any distro, Wayland included), on macOS the zipped .app.
# The release workflow runs it on both.
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p dist
version=$(.toolkit/version)

case "$(uname -s)" in
  Linux)
    (cd app/src-tauri && npx --yes @tauri-apps/cli@2.12.4 build --bundles appimage)
    cp target/release/bundle/appimage/*.AppImage dist/
    ;;
  Darwin)
    (cd app/src-tauri && npx --yes @tauri-apps/cli@2.12.4 build --bundles app)
    ditto -c -k --keepParent target/release/bundle/macos/Overview.app "dist/Overview_${version}_$(uname -m).app.zip"
    ;;
  *) echo "no build for $(uname -s)" >&2; exit 1 ;;
esac
ls -l dist
